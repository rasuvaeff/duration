{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    "minMsi": 93,
    "mutators": {
        "@default": true,
        // Constructor/method parameter declarations with a default value
        // (`private int $x = 100,`, `bool $strict = false,`): the mutant sits on a
        // signature line with no executable opcode under pcov, so it is reported Not
        // Covered whatever the tests do. Only a type-prefixed `$name = default,` line
        // matches; a body line cannot (no type before the variable). Do NOT add ^ or $:
        // Infection wraps the pattern as ^-\s*REGEX$ over the removed diff line.
        // Verified 2026-11-01 by diffing the survivor lists with and without it:
        // bulkhead 6, circuit-breaker 13, json-ld 19 mutants removed, all of them
        // such signature lines; Escaped and Timed Out unchanged.
        "global-ignoreSourceCodeByRegex": [
            "(?:(?:private|protected|public|readonly)\\s+)*\\??[A-Za-z_\\\\][\\w\\\\|]*\\s+\\$\\w+\\s*=\\s*[^,;]+,"
        ],
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed.
        "PublicVisibility": false,
        // Every excluded line below has a PHP-level equivalent-mutant reason:
        // the operand's type is already coerced the same way with or without
        // the explicit cast/comparison, so removing it changes no observable
        // behavior. Excluding them (rather than tolerating them as "escaped"
        // via minMsi slack) keeps the gate meaningful: a real drop in killed
        // mutants stays visible instead of hiding in the same budget as this
        // documented noise.
        "CastFloat": {
            "ignoreSourceCodeByRegex": [
                // %g always produces a well-formed numeric string; PHP 8's
                // number-vs-numeric-string comparison already coerces it the
                // same way the explicit (float) cast does.
                "if \\(\\(float\\) \\$seconds < 60\\.0\\) \\{",
                "if \\(\\(float\\) \\$minutes < 60\\.0\\) \\{",
                "if \\(\\(float\\) \\$hours < 24\\.0\\) \\{",
                // float * int already widens to float regardless of the
                // explicit cast on the multiplier.
                "\\$micros = \\$value \\* \\(float\\) \\$microsPerUnit;",
                // float >= / < int coerces the int operand to float the same
                // way (float) does; see the comment on this line in Duration.php.
                "if \\(\\$micros >= \\(float\\) \\\\PHP_INT_MAX \\|\\| \\$micros < \\(float\\) \\\\PHP_INT_MIN\\) \\{"
            ]
        },
        // The round()-skip threshold guard (`if ($micros < 2 ** 52)`) sits in
        // a numeric dead zone: shrinking or bending the threshold is
        // observable only for a float product carrying an exact .5 fraction
        // between the mutated and the real boundary (2^51..2^53) — and no
        // representable float input maps to such a product through the fixed
        // unit multipliers. The guard's purpose (skipping round() where every
        // double is integral, incl. the PHP >= 8.4 round() regression zone)
        // is pinned positively by intFactoryProductsAreExactInEveryUnit and
        // floatInputInTheRoundRegressionRangeStaysExact instead.
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": ["if \\(\\$micros < 2 \\*\\* 52\\) \\{"]
        },
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": ["if \\(\\$micros < 2 \\*\\* 52\\) \\{"]
        },
        "Exponentiation": {
            "ignoreSourceCodeByRegex": ["if \\(\\$micros < 2 \\*\\* 52\\) \\{"]
        },
        "LessThan": {
            "ignoreSourceCodeByRegex": ["if \\(\\$micros < 2 \\*\\* 52\\) \\{"]
        }
    }
    // min/max `<=`/`>=` → `<`/`>` survive for a different reason: on equal
    // inputs both branches return a value-equal Duration (the contract is
    // value equality via equals(), not identity), so the mutation is
    // unobservable without a brittle `===` assertion that would contradict
    // the value-object semantics. Left as a tolerated (not excluded) survivor
    // — two mutants, priced into minMsi. Measured 2026-11-01 with --with-uncovered:
    // 116 mutants, 0 Not Covered, these 2 Escaped, overall MSI 98%.
}
